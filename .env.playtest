# Modus fuer den automatisierten Playtest (npm run playtest).
#
# Bewusst leere Backend-Zugangsdaten: dadurch ist `isBackendConfigured` false,
# `AuthSystem` wird nie ready und MenuScene loescht den vorgesetzten lokalen
# Spielstand nicht (MenuScene.ts 71-75). Der Testlauf kommt so ohne Login,
# ohne Netz und ohne echte Nutzerdaten bis ins Spiel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
